# DemenX Backend — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ========================================================================================
# ENVIRONMENT
# Set to 'production' in live deployments. This enforces JWT secret validation.
# Values: development | demo | test | production
# ========================================================================================
ENVIRONMENT=development

# ========================================================================================
# DATABASE
# ========================================================================================
# Defaults to local SQLite (suitable for development only)
DATABASE_URL=sqlite:///./demenx.db
# For PostgreSQL in production: postgresql+psycopg2://user:password@localhost:5432/demenx

# ========================================================================================
# SECURITY & JWT
# CRITICAL: Change JWT_SECRET_KEY before any production deployment.
# Must be at least 32 characters and randomly generated.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ========================================================================================
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# ========================================================================================
# DEMO DATA SEEDING
# Set SEED_DEMO_DATA=false in production to prevent fabricated demo records from being
# inserted into a production database. Only set to 'true' for development/demo environments.
# ========================================================================================
SEED_DEMO_DATA=true

# ========================================================================================
# GOOGLE GEMINI API (Optional — DemenX Companion AI)
# If absent, the companion falls back to its deterministic knowledge base.
# The API key is used exclusively server-side and never exposed to browser clients.
# ========================================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ========================================================================================
# MODEL CHECKPOINTS (ResNet-18)
# Paths relative to the backend/ directory, or absolute paths.
# ========================================================================================
MODEL1_PATH=../model1_things/checkpoints/best_model1.pth
MODEL2_PATH=../model2_things/checkpoints/best_model2.pth

# ========================================================================================
# FILE STORAGE DIRECTORIES
# ========================================================================================
UPLOAD_DIR=uploads
RESULTS_DIR=results
MAX_UPLOAD_SIZE=52428800

# ========================================================================================
# CORS ALLOWED ORIGINS (Comma-separated)
# ========================================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ========================================================================================
# COMPUTE DEVICE
# Values: auto | cpu | cuda
# ========================================================================================
DEVICE=auto
